# Copy this file to `.env` and fill in secrets. The app loads `.env` first, then falls back to
# variables here only if you use both files — put real keys in `.env`, not in this template.

# OpenAI (optional if using Ollama only)
OPENAI_API_KEY=

# Default: openai | ollama
LLM_PROVIDER=openai

# OpenAI chat model (vision-capable for images)
OPENAI_CHAT_MODEL=gpt-4o-mini

# OpenAI image model for AI illustrations and infographics
OPENAI_IMAGE_MODEL=gpt-image-1.5

# Ollama (local / open-source)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_VISION_MODEL=llava

# Web UI (Vite dev server). Comma-separated.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Short clips use OpenAI Sora (videos API). Requires API access on your account.

# Optional: local open-source image generation server (AUTOMATIC1111 / SD WebUI)
SD_WEBUI_URL=http://127.0.0.1:7860

# Optional: realistic stock photos embedded in generated .pptx slides (https://www.pexels.com/api/)
PEXELS_API_KEY=

# Copy to .env and fill in values. Never commit .env.

# --- LLM ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2

# CORS (comma-separated)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Database ---
# SQLite (default, file created in project root)
DATABASE_URL=sqlite:///./classroom_ai.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/classroom_ai

# --- Authentication (JWT) ---
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional: auto-create first admin on server startup (only if no admin exists)
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=your-secure-password
# BOOTSTRAP_ADMIN_NAME=Admin

# --- Optional APIs ---
PEXELS_API_KEY=
SD_WEBUI_URL=http://127.0.0.1:7860
